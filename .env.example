# Four allocated full A10080GB cards: one training GPU and three inference replicas.
HINTSD_GPUS=0,1,2,3
HINTSD_PYTHON=python3
# Defaults are portable paths INSIDE this checkout; override only explicitly.
# HINTSD_ENV_PYTHON=/path/to/this-checkout/.env-searchqa/bin/python
# HINTSD_RETRIEVER_PYTHON=/path/to/this-checkout/.env-retriever/bin/python
REPORT_TO=none
TOKENIZERS_PARALLELISM=false
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
OMP_NUM_THREADS=1
